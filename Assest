```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Declaration of Assets and Liabilities (2025–26) - Bihar Govt.</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- html2pdf.js bundle for direct client-side PDF export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <!-- Google Fonts: Inter for UI & Serif for Authentic Official Gazette Look -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Inter:wght@300;400;500;600;700&family=Tinos:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            official: ['"Tinos"', '"Times New Roman"', 'Times', 'serif']
          },
          colors: {
            govblue: {
              50: '#f0f5fa',
              100: '#e1ecf5',
              700: '#1b4d79',
              800: '#143c61',
              900: '#0e2b47'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #94a3b8;
      border-radius: 4px;
    }

    /* Print & Exact A4 Geometry */
    .a4-sheet {
      width: 210mm;
      min-height: 297mm;
      max-height: 297mm;
      height: 297mm;
      padding: 12mm 15mm 10mm 15mm;
      margin: 0 auto 24px auto;
      background: white;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
      box-sizing: border-box;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      page-break-after: always;
      break-after: page;
    }

    /* Table borders replicating official standard */
    .gov-table {
      width: 100%;
      border-collapse: collapse;
      border: 1.5px solid #111827;
      font-size: 11.5px;
      line-height: 1.28;
    }
    .gov-table th, .gov-table td {
      border: 1px solid #111827;
      padding: 4px 6px;
      vertical-align: top;
      color: #0f172a;
    }
    .gov-table th {
      background-color: #f8fafc;
      font-weight: 700;
      text-align: center;
    }

    /* Strict Media Print rules */
    @media print {
      body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .no-print {
        display: none !important;
      }
      #preview-pane {
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        background: transparent !important;
        overflow: visible !important;
      }
      .a4-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        width: 210mm !important;
        height: 297mm !important;
        min-height: 297mm !important;
        max-height: 297mm !important;
        padding: 10mm 14mm 8mm 14mm !important;
        page-break-after: always !important;
        page-break-inside: avoid !important;
        break-after: page !important;
      }
      @page {
        size: A4 portrait;
        margin: 0;
      }
    }
  </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800 min-h-screen flex flex-col">

  <!-- TOP HEADER / ACTION BAR -->
  <header class="no-print bg-govblue-900 text-white shadow-md sticky top-0 z-40 border-b border-govblue-700">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand & Title -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-amber-500 flex items-center justify-center font-bold text-slate-900 shadow-sm text-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div>
          <h1 class="font-bold text-base md:text-lg leading-tight flex items-center gap-2">
            Asset & Liability Declaration Generator
            <span class="text-xs bg-amber-400 text-slate-900 font-semibold px-2 py-0.5 rounded">Year 2025–26</span>
          </h1>
          <p class="text-xs text-slate-300">Prescribed Bihar Govt. & BPSC Teacher Standard Format (A4 4-Page Format)</p>
        </div>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Sample Loader -->
        <button id="btn-load-sample" class="px-3 py-1.5 bg-govblue-700 hover:bg-govblue-800 text-amber-200 border border-amber-300/30 text-xs font-medium rounded shadow transition flex items-center gap-1.5" title="Fill with Ramesh Kumar's official example">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          Load Ramesh Kumar Sample
        </button>

        <!-- Auto Fill Nil -->
        <button id="btn-fill-nil" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 text-xs font-medium rounded transition flex items-center gap-1.5" title="Set all empty fields to Nil">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Fill Blanks with "Nil"
        </button>

        <!-- Clear All -->
        <button id="btn-clear-modal" class="px-2.5 py-1.5 bg-slate-800 hover:bg-red-900/60 text-slate-300 hover:text-red-200 border border-slate-700 text-xs font-medium rounded transition" title="Clear all fields">
          Clear
        </button>

        <!-- View Switcher -->
        <div class="hidden md:flex bg-govblue-800 p-0.5 rounded border border-govblue-700 text-xs font-medium">
          <button id="btn-view-split" class="px-2.5 py-1 rounded bg-amber-400 text-slate-900 font-semibold transition">Split View</button>
          <button id="btn-view-form" class="px-2.5 py-1 rounded text-slate-300 hover:text-white transition">Form Only</button>
          <button id="btn-view-preview" class="px-2.5 py-1 rounded text-slate-300 hover:text-white transition">Preview Only</button>
        </div>

        <!-- Download & Print -->
        <div class="flex items-center gap-1.5 pl-1">
          <button onclick="window.print()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded shadow transition flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            Print / Save PDF
          </button>
          <button id="btn-download-pdf" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded shadow transition flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download PDF
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- NOTIFICATION TOAST -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white text-xs px-4 py-2.5 rounded-lg shadow-xl border border-slate-700 transform translate-y-20 opacity-0 transition duration-300 pointer-events-none flex items-center gap-2">
    <span id="toast-icon">✓</span>
    <span id="toast-msg">Action completed</span>
  </div>

  <!-- CONFIRMATION MODAL (Replaces window.confirm) -->
  <div id="confirm-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 text-center border border-slate-200">
      <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h3 class="text-base font-bold text-slate-800">Clear All Details?</h3>
      <p class="text-xs text-slate-500 mt-1 mb-5">This will erase all personal details, assets, and liabilities entered so far.</p>
      <div class="flex justify-center gap-3">
        <button id="modal-cancel-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">Cancel</button>
        <button id="modal-confirm-btn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg transition">Yes, Clear All</button>
      </div>
    </div>
  </div>

  <!-- MAIN APP CONTAINER -->
  <main class="flex-1 flex flex-col md:flex-row overflow-hidden relative">

    <!-- LEFT COLUMN: INTERACTIVE FORM EDITOR -->
    <section id="form-pane" class="w-full md:w-1/2 lg:w-5/12 bg-white border-r border-slate-200 flex flex-col h-[calc(100vh-62px)] overflow-y-auto no-print">
      
      <!-- Stepper / Section Tabs -->
      <div class="sticky top-0 bg-slate-50 z-20 border-b border-slate-200 p-2">
        <div class="grid grid-cols-5 gap-1 text-[11px] font-semibold text-center">
          <button data-tab="tab-1" class="tab-btn active px-1 py-1.5 rounded bg-govblue-800 text-white shadow-sm flex flex-col items-center">
            <span>Step 1</span>
            <span class="text-[9px] font-normal truncate w-full">Personal</span>
          </button>
          <button data-tab="tab-2" class="tab-btn px-1 py-1.5 rounded bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 flex flex-col items-center">
            <span>Step 2</span>
            <span class="text-[9px] font-normal truncate w-full">Movable</span>
          </button>
          <button data-tab="tab-3" class="tab-btn px-1 py-1.5 rounded bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 flex flex-col items-center">
            <span>Step 3</span>
            <span class="text-[9px] font-normal truncate w-full">Immovable</span>
          </button>
          <button data-tab="tab-4" class="tab-btn px-1 py-1.5 rounded bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 flex flex-col items-center">
            <span>Step 4</span>
            <span class="text-[9px] font-normal truncate w-full">Liabilities</span>
          </button>
          <button data-tab="tab-5" class="tab-btn px-1 py-1.5 rounded bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 flex flex-col items-center">
            <span>Step 5</span>
            <span class="text-[9px] font-normal truncate w-full">Taxes & PRAN</span>
          </button>
        </div>
      </div>

      <!-- Tab Content Area -->
      <form id="asset-form" class="p-4 space-y-5 flex-1" onsubmit="event.preventDefault()">
        
        <!-- STEP 1: EMPLOYEE & FAMILY DETAILS -->
        <div id="tab-1" class="tab-panel space-y-4">
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-900">
            <strong>Mandatory Preamble:</strong> These details form the title section and preamble paragraph on Page 1 of the official declaration.
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Financial Year</label>
              <input type="text" id="financialYear" class="w-full text-xs p-2 border border-slate-300 rounded focus:ring-1 focus:ring-govblue-700" value="2025-26">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Employee Full Name</label>
              <input type="text" id="employeeName" class="w-full text-xs p-2 border border-slate-300 rounded uppercase font-semibold focus:ring-1 focus:ring-govblue-700" placeholder="e.g. RAMESH KUMAR">
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Relation Type</label>
              <select id="relationType" class="w-full text-xs p-2 border border-slate-300 rounded bg-white focus:ring-1 focus:ring-govblue-700">
                <option value="son of">son of</option>
                <option value="daughter of">daughter of</option>
                <option value="wife of">wife of</option>
              </select>
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-slate-700 mb-1">Father's / Husband's Name</label>
              <input type="text" id="relativeName" class="w-full text-xs p-2 border border-slate-300 rounded uppercase focus:ring-1 focus:ring-govblue-700" placeholder="e.g. LATE RAMDHANI SINGH">
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Age (Years)</label>
              <input type="text" id="age" class="w-full text-xs p-2 border border-slate-300 rounded focus:ring-1 focus:ring-govblue-700" placeholder="e.g. 42">
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-slate-700 mb-1">Present Designation</label>
              <input type="text" id="designation" class="w-full text-xs p-2 border border-slate-300 rounded uppercase focus:ring-1 focus:ring-govblue-700" placeholder="e.g. BPSC SCHOOL TEACHER (SENIOR SECONDARY)">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Service / Cadre Name</label>
            <input type="text" id="cadre" class="w-full text-xs p-2 border border-slate-300 rounded uppercase focus:ring-1 focus:ring-govblue-700" placeholder="e.g. BIHAR EDUCATION SERVICE / SCHOOL TEACHER SERVICE">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Department / Office / School Full Address</label>
            <textarea id="department" rows="2" class="w-full text-xs p-2 border border-slate-300 rounded uppercase focus:ring-1 focus:ring-govblue-700" placeholder="e.g. EDUCATION DEPARTMENT, BIHAR (GOVT. UPGRADED HIGH SCHOOL, PATNA)"></textarea>
          </div>

          <!-- DYNAMIC SPOUSE & DEPENDANTS CONTROLLER -->
          <div class="border-t border-slate-200 pt-3 space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="text-xs font-bold text-govblue-800 uppercase tracking-wider">Spouse & Dependants Columns</h4>
                <p class="text-[10px] text-slate-500">Add or remove columns across all 4 printable pages</p>
              </div>
              <button type="button" id="btn-add-dependent" class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-semibold flex items-center gap-1 shadow-sm transition">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                + Add Dependant
              </button>
            </div>

            <!-- Spouse Column Controller -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5">
              <div class="flex items-center justify-between mb-1.5">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="includeSpouse" class="rounded text-govblue-800 focus:ring-govblue-700 h-4 w-4">
                  <span class="text-xs font-bold text-slate-800">Include Spouse Column</span>
                </label>
                <span id="spouse-status-badge" class="text-[10px] px-2 py-0.5 rounded font-medium">Active</span>
              </div>
              <div id="spouse-input-container">
                <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Spouse Name (appears in column headers)</label>
                <input type="text" id="spouseName" class="w-full text-xs p-1.5 border border-slate-300 rounded uppercase focus:ring-1 focus:ring-govblue-700" placeholder="e.g. ANITA KUMARI">
              </div>
            </div>

            <!-- Dependants List -->
            <div>
              <div class="text-[11px] font-semibold text-slate-700 mb-1.5 flex items-center justify-between">
                <span>Dependants List (<span id="dep-count-badge">0</span>)</span>
                <span class="text-[10px] text-slate-400 italic">Name updates table header live</span>
              </div>
              <div id="dependents-list-container" class="space-y-2">
                <!-- Dynamically rendered list of dependants with Remove buttons -->
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: MOVABLE ASSETS (PART A) -->
        <div id="tab-2" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-govblue-800 uppercase">Part A: Movable Assets (7 Items)</h3>
            <span class="text-[11px] text-slate-500">Rendered on Page 1</span>
          </div>

          <p class="text-[11px] text-slate-500 italic">Enter amounts and account/registration numbers. Multiple lines are preserved cleanly in the PDF table.</p>

          <div id="movable-inputs-container" class="space-y-4">
            <!-- Dynamically populated or structured cards for 7 Movable rows -->
          </div>
        </div>

        <!-- STEP 3: IMMOVABLE ASSETS (PART B) -->
        <div id="tab-3" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-govblue-800 uppercase">Part B: Immovable Assets (5 Items)</h3>
            <span class="text-[11px] text-slate-500">Rendered on Pages 2 & 3</span>
          </div>
          <p class="text-[11px] text-slate-500 italic">Specify Location, Survey/Khata/Khesra/Ward, Extent, and Market Value.</p>

          <div id="immovable-inputs-container" class="space-y-4">
            <!-- Dynamically populated cards for 5 Immovable rows -->
          </div>
        </div>

        <!-- STEP 4: LIABILITIES & DUES -->
        <div id="tab-4" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-govblue-800 uppercase">Section (2): Liabilities & Govt. Dues</h3>
            <span class="text-[11px] text-slate-500">Rendered on Page 3</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Outstanding Balance "As on Date"</label>
            <input type="text" id="asOnDate" class="w-full text-xs p-2 border border-slate-300 rounded" value="10-01-2026">
          </div>

          <div id="liabilities-inputs-container" class="space-y-3">
            <!-- Bank, FIs, and Govt Accommodation to Other Dues -->
          </div>
        </div>

        <!-- STEP 5: TAXES & PERSONAL DETAILS (SECTION C) -->
        <div id="tab-5" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-govblue-800 uppercase">Taxes, Section C & Verification</h3>
            <span class="text-[11px] text-slate-500">Rendered on Page 4</span>
          </div>

          <!-- Taxes -->
          <div class="border border-slate-200 rounded-lg p-3 bg-slate-50 space-y-3">
            <h4 class="text-xs font-bold text-slate-700 uppercase">Taxes & Other Liabilities</h4>
            <div id="taxes-inputs-container" class="space-y-2"></div>
          </div>

          <!-- Section C Personal Details -->
          <div class="border border-slate-200 rounded-lg p-3 bg-slate-50 space-y-3">
            <h4 class="text-xs font-bold text-slate-700 uppercase">C. Personal Details</h4>
            
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">GPF / CPF / PRAN No.</label>
                <input type="text" id="pranNo" class="w-full text-xs p-2 border border-slate-300 rounded font-mono uppercase" placeholder="e.g. PRAN-110034928172">
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Gender</label>
                <select id="gender" class="w-full text-xs p-2 border border-slate-300 rounded bg-white">
                  <option value="M">M (Male)</option>
                  <option value="F">F (Female)</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Date of Birth (DD/MM/YYYY)</label>
                <input type="text" id="dob" class="w-full text-xs p-2 border border-slate-300 rounded" placeholder="12/04/1984">
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Class / Group</label>
                <input type="text" id="classGroup" class="w-full text-xs p-2 border border-slate-300 rounded" placeholder="Class / Group B">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Cadre</label>
                <input type="text" id="personalCadre" class="w-full text-xs p-2 border border-slate-300 rounded uppercase" placeholder="e.g. B.E.S. - BIHAR EDUCATION SERVICE">
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Home District</label>
                <input type="text" id="homeDistrict" class="w-full text-xs p-2 border border-slate-300 rounded uppercase" placeholder="PATNA">
              </div>
            </div>
          </div>

          <!-- Verification Block -->
          <div class="border border-slate-200 rounded-lg p-3 bg-slate-50 space-y-2">
            <h4 class="text-xs font-bold text-slate-700 uppercase">Verification & Signature Info</h4>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Place of Declaration</label>
                <input type="text" id="declPlace" class="w-full text-xs p-2 border border-slate-300 rounded uppercase" value="PATNA">
