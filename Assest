    /**
     * DYNAMIC TABLE HEADER BUILDER FOR PAGES 1, 2, AND 3
     */
    function getDynamicTableHeader() {
      const hasSpouse = !!appData.includeSpouse;
      const deps = appData.dependents || [];
      const dynamicColsCount = (hasSpouse ? 1 : 0) + deps.length;

      let dynWidth = '44%';
      if (dynamicColsCount > 0) {
        dynWidth = (44 / dynamicColsCount).toFixed(1) + '%';
      }

      if (dynamicColsCount === 0) {
        return `
          <tr>
            <th style="width: 8%;">Sr.<br>No.</th>
            <th style="width: 46%;">Description</th>
            <th style="width: 46%;">Self</th>
          </tr>
        `;
      }

      let html = `
        <tr>
          <th style="width: 7%;">Sr.<br>No.</th>
          <th style="width: 27%;">Description</th>
          <th style="width: 22%;">Self</th>
      `;

      if (hasSpouse) {
        const spTitle = appData.spouseName ? `(${appData.spouseName})` : '(Spouse)';
        html += `
          <th style="width: ${dynWidth};">Spouse<br><span class="font-normal text-[10px] pv-spouseHeader">${spTitle}</span></th>
        `;
      }

      deps.forEach((d, i) => {
        const dTitle = d.name ? `(${d.name})` : `(Dependant-${i + 1})`;
        html += `
          <th style="width: ${dynWidth};">Dependant-${i + 1}<br><span class="font-normal text-[10px]">${dTitle}</span></th>
        `;
      });

      html += `</tr>`;
      return html;
    }

    function buildRowCells(item) {
      let cells = `
        <td class="text-center font-bold">${item.sr}</td>
        <td>${item.title.replace(/\n/g, '<br>')}</td>
        <td style="white-space: pre-line;">${item.self || 'Nil'}</td>
      `;
      if (appData.includeSpouse) {
        cells += `<td style="white-space: pre-line;">${item.spouse || 'Nil'}</td>`;
      }
      (appData.dependents || []).forEach(dep => {
        const val = (item.depValues && item.depValues[dep.id]) || 'Nil';
        cells += `<td style="white-space: pre-line;">${val}</td>`;
      });
      return cells;
    }

