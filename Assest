    /**
     * ATTACH EVENT LISTENERS
     */
    function attachListeners() {
      const form = document.getElementById('asset-form');

      // Add Dependant Button
      document.getElementById('btn-add-dependent').addEventListener('click', () => {
        const newIndex = (appData.dependents || []).length + 1;
        const newId = 'dep_' + Date.now();
        const defaultName = `DEPENDANT ${newIndex}`;
        appData.dependents.push({ id: newId, name: defaultName });

        appData.movable.forEach(m => {
          if (!m.depValues) m.depValues = {};
          m.depValues[newId] = 'Nil';
        });
        appData.immovable.forEach(im => {
          if (!im.depValues) im.depValues = {};
          im.depValues[newId] = 'Nil';
        });

        persistData();
        buildFormControls();
        renderPreview();
        showToast(`Dependant-${newIndex} column added`);
      });

      // Remove Dependant Button Delegation
      document.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('.btn-remove-dep');
        if (removeBtn) {
          const depId = removeBtn.dataset.removeDep;
          appData.dependents = appData.dependents.filter(d => d.id !== depId);
          appData.movable.forEach(m => {
            if (m.depValues) delete m.depValues[depId];
          });
          appData.immovable.forEach(im => {
            if (im.depValues) delete im.depValues[depId];
          });

          persistData();
          buildFormControls();
          renderPreview();
          showToast('Dependant removed');
        }
      });

      // Spouse Checkbox Toggle
      document.getElementById('includeSpouse').addEventListener('change', (e) => {
        appData.includeSpouse = e.target.checked;
        persistData();
        buildFormControls();
        renderPreview();
        showToast(appData.includeSpouse ? 'Spouse column enabled' : 'Spouse column removed');
      });

      // Dependant Name Live Input
      document.addEventListener('input', (e) => {
        if (e.target.classList.contains('dep-name-input')) {
          const depId = e.target.dataset.depId;
          const dep = (appData.dependents || []).find(d => d.id === depId);
          if (dep) {
            dep.name = e.target.value.toUpperCase();
            persistData();
            renderPreview();
          }
        }
      });

      // Form Delegated Two-Way Binding
      form.addEventListener('input', (e) => {
        const target = e.target;
        const val = target.value;

        // Top level fields
        if (target.id && appData.hasOwnProperty(target.id)) {
          appData[target.id] = val;
        }

        // Section C Personal fields
        if (target.id === 'pranNo') appData.personal.pran = val;
        if (target.id === 'gender') appData.personal.gender = val;
        if (target.id === 'dob') appData.personal.dob = val;
        if (target.id === 'classGroup') appData.personal.classGroup = val;
        if (target.id === 'personalCadre') appData.personal.personalCadre = val;
        if (target.id === 'homeDistrict') appData.personal.homeDistrict = val;
        if (target.id === 'declPlace') appData.personal.place = val;
        if (target.id === 'declDate') appData.personal.date = val;
        if (target.id === 'asOnDate') appData.asOnDate = val;

        // Movable Array inputs
        if (target.dataset.m !== undefined) {
          const idx = parseInt(target.dataset.m);
          const field = target.dataset.field;
          appData.movable[idx][field] = val;
        }

        // Movable Dependant inputs
        if (target.dataset.mDep !== undefined) {
          const depId = target.dataset.mDep;
          const idx = parseInt(target.dataset.idx);
          if (!appData.movable[idx].depValues) appData.movable[idx].depValues = {};
          appData.movable[idx].depValues[depId] = val;
        }

        // Immovable Array inputs
        if (target.dataset.im !== undefined) {
          const idx = parseInt(target.dataset.im);
          const field = target.dataset.field;
          appData.immovable[idx][field] = val;
        }

        // Immovable Dependant inputs
        if (target.dataset.imDep !== undefined) {
          const depId = target.dataset.imDep;
          const idx = parseInt(target.dataset.idx);
          if (!appData.immovable[idx].depValues) appData.immovable[idx].depValues = {};
          appData.immovable[idx].depValues[depId] = val;
        }

        // Liabilities Array inputs
        if (target.dataset.lia !== undefined) {
          const idx = parseInt(target.dataset.lia);
          const field = target.dataset.field;
          appData.liabilities[idx][field] = val;
        }

        // Taxes Array inputs
        if (target.dataset.tax !== undefined) {
          const idx = parseInt(target.dataset.tax);
          const field = target.dataset.field;
          appData.taxes[idx][field] = val;
        }

        persistData();
        renderPreview();
      });

      // Quick "Set All Nil" for an individual asset card
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('btn-quick-nil')) {
          const type = e.target.dataset.target;
          const idx = parseInt(e.target.dataset.idx);
          const targetList = type === 'm' ? appData.movable : appData.immovable;
          const item = targetList[idx];

          item.self = 'Nil';
          if (appData.includeSpouse) item.spouse = 'Nil';
          if (!item.depValues) item.depValues = {};
          (appData.dependents || []).forEach(d => {
            item.depValues[d.id] = 'Nil';
          });

          persistData();
          buildFormControls();
          renderPreview();
          showToast(`Row marked as 'Nil'`);
        }
      });

      // Stepper Tab Switching
      const tabBtns = document.querySelectorAll('.tab-btn');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTabId = btn.dataset.tab;
          tabBtns.forEach(b => {
            b.classList.remove('bg-govblue-800', 'text-white', 'shadow-sm', 'active');
            b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
          });
          btn.classList.add('bg-govblue-800', 'text-white', 'shadow-sm', 'active');
          btn.classList.remove('bg-white', 'text-slate-600', 'border');

          document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
          document.getElementById(targetTabId).classList.remove('hidden');
        });
      });

      // Prev/Next Step Buttons
      const stepOrder = ['tab-1', 'tab-2', 'tab-3', 'tab-4', 'tab-5'];
      document.getElementById('btn-next-step').addEventListener('click', () => {
        const activeTab = document.querySelector('.tab-btn.active').dataset.tab;
        const currentIdx = stepOrder.indexOf(activeTab);
        if (currentIdx < stepOrder.length - 1) {
          const nextBtn = document.querySelector(`[data-tab="${stepOrder[currentIdx + 1]}"]`);
          nextBtn.click();
        }
      });
      document.getElementById('btn-prev-step').addEventListener('click', () => {
        const activeTab = document.querySelector('.tab-btn.active').dataset.tab;
        const currentIdx = stepOrder.indexOf(activeTab);
        if (currentIdx > 0) {
          const prevBtn = document.querySelector(`[data-tab="${stepOrder[currentIdx - 1]}"]`);
          prevBtn.click();
        }
      });

      // Load Sample Data
      document.getElementById('btn-load-sample').addEventListener('click', () => {
        appData = JSON.parse(JSON.stringify(sampleData));
        persistData();
        buildFormControls();
        renderPreview();
        showToast("Ramesh Kumar (BPSC Teacher) official sample loaded!");
      });

      // Fill Empty Fields with "Nil"
      document.getElementById('btn-fill-nil').addEventListener('click', () => {
        appData.movable.forEach(m => {
          if (!m.self || m.self.trim() === '') m.self = 'Nil';
          if (appData.includeSpouse && (!m.spouse || m.spouse.trim() === '')) m.spouse = 'Nil';
